{
  "name": "gymtrack",
  "version": "1.0.0",
  "description": "GymTrack - Sistema web para gestión y seguimiento de entrenamientos",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint-sonarjs.json"
  },
  "author": "Equipo GymTrack",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "reports/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
